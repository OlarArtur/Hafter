// Copy to Hafter/Config.xcconfig (gitignored). Do not commit a real key.
//
// Movie search calls https://api.themoviedb.org with this v3 key in every
// build (Debug and Release) while TMDB_USE_PROXY is NO. The value is copied
// into Info.plist as TMDbAPIKeyV3. Leave it blank and search fails with a
// visible error and an Xcode log.
//
// The Cloud Functions proxy in functions/ stays in the repo. It needs the
// Firebase Blaze plan and a deploy. Do not turn it on until you want that.
// See README.md and functions/README.md.

TMDB_API_KEY_V3 = your_v3_key
TMDB_USE_PROXY = NO

// Only read when TMDB_USE_PROXY = YES. Empty uses
// https://us-central1-<firebase-project-id>.cloudfunctions.net/tmdb
TMDB_PROXY_BASE_URL =
